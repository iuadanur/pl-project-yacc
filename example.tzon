# variable declarations
var age = 23;
var pi = 3.14;
var isActive = true;
var name = "utku";
print(name); # output: utku
var grade = 'A';
var fileName = "";

# constants
const MAX_SIZE = 100;
const LANG = "TZON";

# reassignment
isActive = false;
name = "melih";
print(name); # output: melih
grade = 'B';

# arithmetic operations
var sum = 10 + 20; # sum = 30
var division = 9.0 / 3.0; # division = 3
var remainder = 10 % 3; # remainder = 1
var complex = (sum * 2) - (remainder + 4); # complex = 55

# arrays
var numbers = [1, 2, 3, 4, 5];
var first = numbers[0];
print("first "+ first); # first = 1
numbers[2] = 99;
print("numbers after update: " + numbers); # numbers after update = [1, 2, 99, 4, 5]

# functions
fn add(x, y) {
    return x + y;
}

fn pow2(n) {
    return n * n;
}

# if / elif / else
if age > 30 {
    print("age greater than 30"); # output: age greater than 30
} elif age == 30 {
    print("age is 30"); # output: age is 30
} else {
    print("age less than 30"); # output: age less than 30
}

# while loop
while age < 26 {
    age = age + 1;
}

# break / continue
var k = 0;
while k < 7 {
    k++;
    if k == 2 {
        continue;
    }
    if k == 6 {
        break;
    }
    print("k: " + k); # output (line by line): k: 1, k: 3, k: 4, k: 5
}

# for loop
var i = 0;
for (i = 0; i < 5; i = i + 1) {
    print(i); # output (line by line): 0, 1, 2, 3, 4
}

# compound assignment / inc-dec
var counter = 1;
print("counter init (=1): " + counter); # output: counter init (=1): 1
counter += 4;
print("counter after +=4: " + counter); # output: counter after +=4: 5
counter--;
print("counter after --: " + counter); # output: counter after --: 4
counter *= 2;
print("counter after *=2: " + counter); # output: counter after *=2: 8
counter /= 2;
print("counter after /=2: " + counter); # output: counter after /=2: 4
counter %= 3;
print("counter after %=3: " + counter); # output: counter after %=3: 1

# built-ins: range / len
var evens = range(0, 10, 2);
print("evens: " + evens); # output: evens: [0, 2, 4, 6, 8]
print("len(evens): " + len(evens)); # output: len(evens): 5
print("len(name): " + len(name)); # output: len(name): 5

# slicing (array + string)
print("evens[1:]: " + evens[1:]); # output: evens[1:]: [2, 4, 6, 8]
print("evens[:3]: " + evens[:3]); # output: evens[:3]: [0, 2, 4]
print("evens[::-1]: " + evens[::-1]); # output: evens[::-1]: [8, 6, 4, 2, 0]
print("name[0:4]: " + name[0:4]); # output: name[0:4]: meli

# exceptions
try {
    if age > MAX_SIZE {
        throw "age is too big";
    }
} catch (err) {
    print("caught: " + err); # output (if thrown): caught: age is too big
} finally {
    print("finally block"); # output: finally block
}

# io
print("enter file name"); # output: enter file name
scan(fileName);

# use of functions and expressions
var f6 = add(5, 7);
var sq = pow2(7);
print("sum: " + f6); # output: sum: 12
print("square: " + sq); # output: square: 49
# the end of the example program
