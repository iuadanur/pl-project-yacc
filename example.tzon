# io statement
scan(fileName);

# basic while loop
while age < 18 {
    print("you are not old enough to get in!");
    age = age + 1;
}

# a basic add function with parameters
fn add(int x, int y) : int {
    return x + y;
}

# a basic power function
fn pow2(int n) : int {
    return n * n;
}

# a basic gender revealing function
fn getGender(string gender) : char {
    if gender == "male" {
        return 'm';
    }
    elif gender == "female" {
        return 'f';
    }
    else {
        return 'u'; # unknown
    }
}

# an example recursive function
fn fibonacci(int s) : int {
    if s < 2 {
        return 1;
    }
    else {
        return fibonacci(s - 1) + fibonacci(s - 2);
    }
}

# nested control example
if isActive {
    if grade == 'A' {
        print("top grade");
    } elif grade == 'B' {
        print("good grade");
    } else {
        print("keep studying");
    }
}

# conditional statements: if, elif, else
if x > 10 {
    print("x is greater than 10");
} elif x == 10 {
    print("x is exactly 10");
} else {
    print("x is less than 10");
}

# logical expressions
var int i = 3;
while i < 6 && i > 2 {
    i = i + 1;
}
print(i);

if i == 5 || i < 4 {
    i = i + 1;
    print(i);
}

# use of functions and expressions
var int f6 = fibonacci(6);
var int sq = pow2(7);
print("fib6: " + f6);
print("square: " + sq);

