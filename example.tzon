# variable declarations
var age = 23;
var pi = 3.14;
var isActive = true;
var name = "utku";
var grade = 'A';
var fileName = "";

# constants
const MAX_SIZE = 100;
const LANG = "TZON";

# reassignment
isActive = false;
name = "melih";
grade = 'B';

# arithmetic operations
var sum = 10 + 20;
var division = 9.0 / 3.0;
var remainder = 10 % 3;
var complex = (sum * 2) - (remainder + 4);

# arrays
var numbers = [1, 2, 3, 4, 5];
var first = numbers[0];
numbers[2] = 99;

# functions
fn add(x, y) {
    return x + y;
}

fn pow2(n) {
    return n * n;
}

# if / elif / else
if age > 30 {
    print("age greater than 30");
} elif age == 30 {
    print("age is 30");
} else {
    print("age less than 30");
}

# while loop
while age < 26 {
    age = age + 1;
}

# for loop
var i = 0;
for (i = 0; i < 5; i = i + 1) {
    print(i);
}

# exceptions
try {
    if age > MAX_SIZE {
        throw "age is too big";
    }
} catch (err) {
    print("caught: " + err);
} finally {
    print("finally block");
}

# io
print("enter file name");
scan(fileName);

# use of functions and expressions
var f6 = add(5, 7);
var sq = pow2(7);
print("sum: " + f6);
print("square: " + sq);
# the end of the example program
