# exceptions.tzon
try {
    print("in try block");
    throw "basic error";
    print("this will not run");
} catch (e) {
    print("caught: " + e);
} finally {
    print("finally runs");
}

fn safe_div(a, b) {
    if b == 0 {
        throw "divide by zero";
    }
    return a / b;
}

try {
    var ok = safe_div(10, 2);
    print("ok: " + ok);
    var bad = safe_div(10, 0);
    print("bad: " + bad);
} catch (err) {
    print("error: " + err);
}

# nested try-catch to test propagation
try {
    try {
        throw "inner error";
    } catch (e) {
        print("inner caught: " + e);
        throw "rethrow";
    }
} catch (outer) {
    print("outer caught: " + outer);
}

# ensure finally runs even on exception
try {
    throw "boom";
} catch (e) {
    print("caught: " + e);
} finally {
    print("cleanup after boom");
}

# uncaught at end (should stop execution)
throw "fatal error";
print("unreachable after fatal");